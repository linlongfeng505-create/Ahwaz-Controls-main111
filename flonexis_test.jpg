    <script>
        (function () {
            var loaded = false;
            function loadRecaptcha() {
                if (loaded || document.getElementById('recaptcha-api-js')) return;
                loaded = true;
                var s = document.createElement('script');
                s.id = 'recaptcha-api-js';
                s.src = 'https://www.google.com/recaptcha/api.js';
                s.async = true;
                s.defer = true;
                document.head.appendChild(s);
                remove();
            }
            var events = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'focusin', 'mousemove'];
            function remove() {
                events.forEach(function (ev) {
                    window.removeEventListener(ev, loadRecaptcha, opts);
                });
            }
            var opts = { once: true, passive: true, capture: true };
            events.forEach(function (ev) {
                window.addEventListener(ev, loadRecaptcha, opts);
            });
            window.loadRecaptcha = loadRecaptcha;
        })();
    </script>
        
            <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (document.cookie.indexOf('cookie-consent') === -1) {
                setTimeout(function () {
                    document.getElementById('cookie').classList.remove(('d-none'));
                }, 5000);
            }
            const buttons = ['cookie_consent', 'cookie_decline'];

            function setCookies() {
                return axios.get('/set_cookies')
                    .then(({data}) => {
                        if (data === 'ok') {
                            document.getElementById('cookie').classList.add('d-none');
                        }
                    })
            }

            function hideCookieConsent() {
                buttons.forEach(id => {
                    const btn = document.getElementById(id);
                    if (btn) {
                        btn.addEventListener('click', setCookies);
                    }
                });
            }

            hideCookieConsent();
        })
    </script>
            <script>
        document.querySelectorAll('[data-clipboard-email]').forEach(function (link) {
            var tip = document.createElement('span');
            tip.className = 'email-copied-tip';
            tip.textContent = 'Email copied!';
            link.appendChild(tip);

            link.addEventListener('click', function (e) {
                var email = link.getAttribute('data-clipboard-email');
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(email).then(function () {
                        tip.classList.add('visible');
                        setTimeout(function () {
                            tip.classList.remove('visible');
                        }, 2000);
                    });
                }
            });
        });
    </script>
        <script>
        (function () {
            var loader = document.getElementById('page-loader');

            function hideLoader() {
                if (loader) loader.classList.remove('page-loader--visible');
            }

            function showLoader() {
                if (loader) loader.classList.add('page-loader--visible');
            }

            window.addEventListener('pageshow', function (e) {
                if (e.persisted) hideLoader();
            });
            document.addEventListener('click', function (e) {
                var link = e.target.closest('a');
                if (!link) return;
                if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                var href = link.getAttribute('href');
                if (!href) return;
                if (href === '' || href.charAt(0) === '#') return;
                if (/^(javascript:|mailto:|tel:)/i.test(href)) return;
                if (link.target === '_blank') return;
                if (link.hasAttribute('data-no-loader')) return;
                showLoader();
            });
        })();
    </script>
