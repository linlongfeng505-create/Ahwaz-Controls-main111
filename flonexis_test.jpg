        <style>
            #cc--main .title {
                font-size: 17px !important;
                margin-bottom: 15px !important;
            }

            #cc--main .title:after {
                background: none !important;
            }

            .cookie-banner {
                position: fixed;
                bottom: 16px;
                left: 50%;
                transform: translateX(-50%);
                width: calc(100% - 32px);
                max-width: 1180px;
                background: #ffffff;
                color: #1f2937;
                padding: 14px 20px;
                border-radius: 14px;
                border: 1px solid rgba(15, 23, 42, 0.08);
                box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12), 0 2px 6px rgba(15, 23, 42, 0.06);
                z-index: 9999;
                animation: fadeInUp 0.35s ease;
                backdrop-filter: saturate(180%) blur(8px);
            }

            .cookie-content {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
                flex-wrap: nowrap;
            }

            .cookie-banner p {
                margin: 0;
                font-size: 13.5px;
                line-height: 1.5;
                color: #4b5563;
                flex: 1;
                min-width: 0;
            }

            .cookie-banner a {
                color: #2563eb;
                text-decoration: none;
                font-weight: 500;
                border-bottom: 1px solid rgba(37, 99, 235, 0.25);
                transition: border-color 0.2s ease, color 0.2s ease;
            }

            .cookie-banner a:hover {
                color: #1d4ed8;
                border-bottom-color: #1d4ed8;
            }

            .cookie-banner .buttons {
                display: flex;
                gap: 8px;
                flex-shrink: 0;
            }

            .cookie-btn {
                border: none;
                padding: 9px 18px;
                border-radius: 8px;
                cursor: pointer;
                font-size: 13.5px;
                font-weight: 600;
                letter-spacing: 0.1px;
                transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
                white-space: nowrap;
                line-height: 1.2;
            }

            .cookie-btn:active {
                transform: translateY(1px);
            }

            #cookie_consent {
                background: #2563eb;
                color: #fff;
                box-shadow: 0 1px 2px rgba(37, 99, 235, 0.25);
            }

            #cookie_consent:hover {
                background: #1d4ed8;
            }

            #cookie_decline {
                background: transparent;
                color: #4b5563;
                border: 1px solid #d1d5db;
            }

            #cookie_decline:hover {
                background: #f3f4f6;
                color: #111827;
                border-color: #9ca3af;
            }

            [data-clipboard-email] {
                position: relative;
            }

            [data-clipboard-email] .email-copied-tip {
                position: absolute;
                bottom: calc(100% + 6px);
                left: 50%;
                transform: translateX(-50%);
                background: #1f2937;
                color: #fff;
                font-size: 12px;
                font-weight: 500;
                padding: 4px 10px;
                border-radius: 6px;
                white-space: nowrap;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.2s ease;
                z-index: 9999;
            }

            [data-clipboard-email] .email-copied-tip.visible {
                opacity: 1;
            }

            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translate(-50%, 20px);
                }
                to {
                    opacity: 1;
                    transform: translate(-50%, 0);
                }
            }

            @media (max-width: 768px) {
                .cookie-banner {
                    padding: 14px 16px;
                    border-radius: 12px;
                }

                .cookie-content {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 12px;
                }

                .cookie-banner .buttons {
                    width: 100%;
                }

                .cookie-btn {
                    flex: 1;
                    text-align: center;
                    padding: 10px 14px;
                }
            }
        </style>
        <style>
            .ix-header__contacts [class^="flaticon-"]:before,
            .ix-header__contacts [class*=" flaticon-"]:before {
                font-size: 12px !important;
