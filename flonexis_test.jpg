        <script>
            (function () {
                document.addEventListener('DOMContentLoaded', function () {
                    var search = document.querySelector('.ix-header__search-inline');
                    if (!search) return;
                    var sBtn = search.querySelector('.ix-header__search-inline__btn');
                    var panel = search.querySelector('.ix-header__search-inline__panel');
                    var icon = search.querySelector('.ix-header__search-inline__panel-icon');
                    var sInput = panel && panel.querySelector('input');
                    var submit = panel && panel.querySelector('.ix-header__search-inline__panel-submit');

                    function applyPanelBaseStyles() {
                        if (!panel) return;
                        panel.style.position = 'absolute';
                        panel.style.top = 'calc(100% + 12px)';
                        panel.style.right = '0';
                        panel.style.width = '360px';
                        panel.style.maxWidth = '80vw';
                        panel.style.background = '#ffffff';
                        panel.style.border = '1px solid #e8e4d8';
                        panel.style.borderRadius = '999px';
                        panel.style.padding = '4px 4px 4px 16px';
                        panel.style.boxShadow = '0 2px 6px rgba(20,17,13,.06), 0 18px 44px -18px rgba(20,17,13,.22)';
                        panel.style.display = 'flex';
                        panel.style.alignItems = 'center';
                        panel.style.gap = '8px';
                        panel.style.zIndex = '200';
                        panel.style.margin = '0';
                        panel.style.boxSizing = 'border-box';
                    }

                    function applyInputStyles() {
                        if (!sInput) return;
                        sInput.style.flex = '1';
                        sInput.style.minWidth = '0';
                        sInput.style.width = 'auto';
                        sInput.style.maxWidth = 'none';
                        sInput.style.background = 'transparent';
                        sInput.style.border = '0';
                        sInput.style.outline = 'none';
                        sInput.style.boxShadow = 'none';
                        sInput.style.color = '#14110d';
                        sInput.style.fontSize = '13px';
                        sInput.style.lineHeight = '1.5';
                        sInput.style.padding = '8px 4px';
                        sInput.style.height = 'auto';
                        sInput.style.borderRadius = '0';
                        sInput.style.position = 'static';
                        sInput.style.visibility = 'visible';
                        sInput.style.display = 'block';
                    }

                    function applySubmitStyles() {
                        if (!submit) return;
                        submit.style.flexShrink = '0';
                        submit.style.width = '32px';
                        submit.style.height = '32px';
                        submit.style.borderRadius = '50%';
                        submit.style.background = '#e60000';
                        submit.style.border = '0';
                        submit.style.color = '#fff';
                        submit.style.display = 'grid';
                        submit.style.placeItems = 'center';
                        submit.style.cursor = 'pointer';
                        submit.style.padding = '0';
                        submit.style.flexShrink = '0';
                    }

                    function applyIconStyles() {
                        if (!icon) return;
                        icon.style.flexShrink = '0';
                        icon.style.width = '15px';
                        icon.style.height = '15px';
                        icon.style.color = '#8a8479';
                        icon.style.display = 'block';
                    }

                    applyPanelBaseStyles();
                    applyInputStyles();
                    applySubmitStyles();
                    applyIconStyles();

                    function setSearch(open) {
                        search.dataset.state = open ? 'open' : 'closed';
                        if (sBtn) sBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                        if (panel) {
                            if (open) {
                                panel.style.opacity = '1';
                                panel.style.visibility = 'visible';
                                panel.style.transform = 'translateY(0)';
                                panel.style.pointerEvents = 'auto';
                                panel.style.transition = 'opacity .2s ease, transform .2s ease, visibility 0s linear 0s';
                            } else {
                                panel.style.opacity = '0';
                                panel.style.visibility = 'hidden';
                                panel.style.transform = 'translateY(-6px)';
                                panel.style.pointerEvents = 'none';
                                panel.style.transition = 'opacity .2s ease, transform .2s ease, visibility 0s linear .2s';
                            }
                        }
                        if (open && sInput) setTimeout(function () {
                            sInput.focus();
                        }, 160);
                    }

                    setSearch(false);

                    if (sBtn) {
                        sBtn.addEventListener('click', function () {
                            setSearch(search.dataset.state !== 'open');
                        });
                    }
                    if (sInput) {
                        sInput.addEventListener('keydown', function (e) {
                            if (e.key === 'Escape') {
                                setSearch(false);
                                if (sBtn) sBtn.focus();
                            }
                        });
                    }
                    document.addEventListener('click', function (e) {
                        if (search.dataset.state === 'open' && !search.contains(e.target)) {
                            setSearch(false);
                        }
                    });
                });
            })();
        </script>
    </div>
        

