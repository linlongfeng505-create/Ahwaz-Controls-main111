                padding: 6px 8px 6px 20px !important;
            }

            .ix-header__brand {
                margin-right: auto !important;
            }

            .ix-header__brand img {
                height: 44px !important;
                width: auto !important;
            }

            .navbar-header-wrapper {
                margin-left: 0 !important;
            }

            .ix-header__search-wrap {
                order: 3;
                flex: none;
            }

            
            .ix-header__contacts {
                order: 4;
            }

            .ix-header__search-inline {
                position: relative;
                display: inline-flex;
                flex: none;
            }

            .ix-header__search-inline__btn,
            .ix-header__search-wrap #search_glass,
            .ix-header__search-wrap button[type="submit"] {
                width: 34px !important;
                height: 34px !important;
                border-radius: 50% !important;
                background: #e60000 !important;
                border: 0 !important;
                color: #fff !important;
                display: grid !important;
                place-items: center !important;
                cursor: pointer !important;
                padding: 0 !important;
                box-shadow: none !important;
                outline: none !important;
                transition: background .15s ease !important;
            }

            .ix-header__search-inline__btn:hover,
            .ix-header__search-wrap #search_glass:hover,
            .ix-header__search-wrap button[type="submit"]:hover,
            .ix-header__search-inline[data-state="open"] .ix-header__search-inline__btn {
                background: #c40000 !important;
            }

            .ix-header__search-inline__btn [class^="flaticon-"]:before,
            .ix-header__search-inline__btn [class*=" flaticon-"]:before,
            .ix-header__search-wrap #search_glass [class^="flaticon-"]:before,
            .ix-header__search-wrap #search_glass [class*=" flaticon-"]:before {
                font-size: 13px !important;
                color: #fff !important;
            }

            .ix-header__search-inline__panel {
                position: absolute !important;
                top: calc(100% + 12px) !important;
                right: 0 !important;
                width: min(360px, 80vw) !important;
                background: #ffffff !important;
                border: 1px solid #e8e4d8 !important;
                border-radius: 999px !important;
                padding: 4px 4px 4px 16px !important;
                box-shadow: 0 1px 0 rgba(255, 255, 255, .6) inset, 0 2px 6px rgba(20, 17, 13, .05), 0 18px 44px -18px rgba(20, 17, 13, .22) !important;
                display: flex !important;
                align-items: center !important;
                gap: 8px !important;
                opacity: 0;
                transform: translateY(-6px);
                pointer-events: none;
                visibility: hidden;
                transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s;
                z-index: 200 !important;
                margin: 0 !important;
            }

            .ix-header__search-inline[data-state="open"] .ix-header__search-inline__panel {
                opacity: 1 !important;
                transform: translateY(0) !important;
                pointer-events: auto !important;
                visibility: visible !important;
                transition: opacity .2s ease, transform .2s ease, visibility 0s linear 0s;
            }

            .ix-header__search-inline__panel-icon {
                flex: none !important;
                width: 15px !important;
                height: 15px !important;
                color: #8a8479 !important;
            }

            .ix-header__search-inline__panel input {
                position: relative !important;
                top: auto !important;
                left: auto !important;
                visibility: visible !important;
                flex: 1 !important;
                background: transparent !important;
                border: 0 !important;
                outline: none !important;
                color: #14110d !important;
                font-family: inherit !important;
                font-size: 13px !important;
                padding: 8px 4px !important;
                min-width: 0 !important;
                box-shadow: none !important;
                width: auto !important;
                max-width: none !important;
                border-radius: 0 !important;
                height: auto !important;
            }

            .ix-header__search-inline__panel input::placeholder {
                color: #8a8479 !important;
            }

            .ix-header__search-inline__panel-submit {
                flex: none !important;
                width: 32px !important;
                height: 32px !important;
                border-radius: 50% !important;
                background: #e60000 !important;
                border: 0 !important;
                color: #fff !important;
                display: grid !important;
                place-items: center !important;
                cursor: pointer !important;
                padding: 0 !important;
                transition: background .15s ease !important;
            }

            .ix-header__search-inline__panel-submit:hover {
                background: #c40000 !important;
            }

            .ix-header__search-inline__panel-submit svg {
                width: 14px !important;
                height: 14px !important;
            }

            /* burger open: wrap nav to new row, left-align items */
            .ix-header--nav-open .ix-header__inner {
                flex-wrap: wrap !important;
            }

            .ix-header--nav-open .ix-header__nav {
                align-items: flex-start !important;
            }

            .ix-header--nav-open .ix-header__nav a,
            .ix-header--nav-open .ix-header__nav .nav-link {
                text-align: left !important;
            }

            /* drawer contacts */
            .ix-header__drawer-contacts {
                display: none;
                width: 100%;
                margin-top: 10px;
                padding: 12px 0 4px;
                border-top: 1px solid #e8e4d8;
                flex-direction: column;
                gap: 2px;
            }

            .ix-header--nav-open .ix-header__drawer-contacts {
                display: flex !important;
            }

            .ix-header__drawer-contacts a {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                padding: 10px 14px;
                font-size: 13px;
                color: #5a564f;
                text-decoration: none;
                border-radius: 8px;
                transition: background .15s ease, color .15s ease;
            }

            .ix-header__drawer-contacts a:hover {
                background: #f3f2ec;
                color: #e60000;
            }

            .ix-header__drawer-contacts svg {
                width: 14px;
                height: 14px;
                color: #8a8479;
                flex: none;
            }

            .ix-header__drawer-contacts a:hover svg {
                color: #e60000;
            }

            /* ix-hero layout fixes */
            .ix-hero__body {
                display: block !important;
                padding-top: clamp(32px, 4vh, 56px) !important;
                padding-bottom: clamp(16px, 1.6vh, 24px) !important;
                width: 100% !important;
            }

            .ix-hero__layout {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
                gap: clamp(40px, 5vw, 72px) !important;
                align-items: center !important;
            }

            .ix-hero__aside {
                display: flex !important;
                align-items: center !important;
                justify-content: flex-end !important;
                width: 100% !important;
            }

            .ix-hero-image {
                position: relative !important;
                width: 100% !important;
                max-width: 560px !important;
                aspect-ratio: 4/3 !important;
            }

            .ix-hero-image__img {
                position: absolute !important;
                inset: 0 !important;
                width: 100% !important;
                height: 100% !important;
                display: block !important;
                object-fit: contain !important;
            }

            .ix-hero-facts {
                display: flex !important;
                flex-direction: row !important;
                align-items: stretch !important;
                flex-wrap: wrap !important;
                justify-content: center !important;
                gap: clamp(20px, 4vw, 56px) !important;
                margin-top: clamp(40px, 6vw, 64px) !important;
                padding-top: clamp(28px, 3.5vw, 40px) !important;
                border-top: 1px solid #e8e4d8 !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }

            .ix-hero-fact__sep {
                width: 1px !important;
                min-height: 40px !important;
                align-self: stretch !important;
                background: #e8e4d8 !important;
                flex-shrink: 0 !important;
                display: block !important;
            }

            @media (max-width: 900px) {
                .ix-hero__layout {
                    grid-template-columns: 1fr !important;
                }

                .ix-hero__aside {
                    display: flex !important;
                    justify-content: center !important;
                    margin-top: 24px !important;
                }

                .ix-hero-image {
                    max-width: min(460px, 92vw) !important;
